card WarmupBreathing
tags [Warmup, Calm]
progress 20
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Sitting
{
    let breaths = round(3 * Card.Intensity)
    repeat breaths {
        wait 500ms
    }
    Session.Mood += 1
}

card WarmupCounting
tags [Warmup, Focus]
progress 20
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Sitting
{
    let beats = random(3..5)
    repeat beats {
        wait 300ms
    }
    Session.Mood += 2
}

card WarmupCheckIn
tags [Warmup, Recovery]
progress 25
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Sitting
{
    await Popup.Ready("Engineering warmup: take a comfortable breath, then continue.")
    wait 500ms
}

card WarmupStandingOnly
tags [Warmup, Standing, Energetic]
progress 20
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Standing
requires World.Ankles == Free
{
    wait 1s
}

card MainStandingPoise
tags [Main, Standing, Focus]
progress 20
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Standing
{
    await Lara.PersistentPose(Main1)
    wait 1s
    Session.Mood += 1
}

card MainStandingVariation
tags [Main, Standing, Calm]
progress 15
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Standing
{
    await Lara.PersistentPose(SexyVamp)
    let beats = round(2 * Card.Intensity)
    repeat beats {
        wait 500ms
    }
}

card MainStandingCheckIn
tags [Main, Standing, Recovery]
progress 20
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Standing
{
    await Lara.PersistentPose(CrossedArmsAmused)
    await Popup.Ready("Engineering standing beat: confirm that you are comfortable.")
}

card MainSeatedRhythm
tags [Main, Sitting, Focus]
progress 20
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Sitting
{
    await Lara.PersistentSitPose(Lounging)
    let beats = round(3 * Card.Intensity)
    repeat beats {
        wait 400ms
    }
}

card MainSeatedPause
tags [Main, Sitting, Calm]
progress 15
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Sitting
{
    let pause = random(1..2)
    wait pause
    Session.Mood += 2
}

card MainSeatedCheckIn
tags [Main, Sitting, Recovery]
progress 25
weight 1
repeat unlimited
cooldown 1
requires Lara.Posture == Sitting
{
    await Popup.Ready("Engineering seated beat: take a slow breath, then continue.")
    wait 500ms
}

card ResolutionBreathing
tags [Resolution, Calm]
progress 0
weight 1
repeat once
cooldown 0
requires Lara.Posture == Standing
{
    await Popup.Ready("Engineering resolution: finish with three comfortable breaths.")
    repeat 3 {
        wait 500ms
    }
}

card ResolutionReflection
tags [Resolution, Focus]
progress 0
weight 1
repeat once
cooldown 0
requires Lara.Posture == Standing
{
    await Lara.PersistentPose(Sassy)
    await Popup.Ready("Engineering resolution: take a moment to reflect, then finish.")
    Session.Mood += 1
}

card EquipmentButtPlug
tags [Main, equipment:butt-plug]
progress 10
weight 1
repeat once
cooldown 0
requires Lara.Posture == Sitting
requires Equipment.IsPrepared("butt-plug")
{
    await Popup.Ready("Engineering equipment beat: confirm butt-plug is prepared and ready.")
    Equipment.Activate("butt-plug")
    World.Anal = Occupied
    wait 1s
}

