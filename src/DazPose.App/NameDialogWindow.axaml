<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DazPose.App.NameDialogWindow"
        Title="Create Unity Folder"
        Width="460" Height="190" MinWidth="400" MinHeight="170"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="18" RowSpacing="12">
    <TextBlock x:Name="PromptText" Grid.Row="0" Text="Enter a name for the child folder." TextWrapping="Wrap" />
    <TextBox x:Name="NameBox" Grid.Row="1" PlaceholderText="Folder name" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" MinWidth="82" Click="CancelClicked" />
      <Button Content="Create" MinWidth="82" IsDefault="True" Click="CreateClicked" />
    </StackPanel>
  </Grid>
</Window>
