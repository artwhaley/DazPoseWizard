  "firstContactDialogue": {
    "count": 19,
    "items": [
      {
        "id": "dialogue:eec70a38ba9e5e0539d420b21b86871ccda9083d63212e7df37796d6a4822480",
        "index": 1,
        "transcript": "Hi there. I was hoping you were brave enough to meet me.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_01_Intro_BraveEnough.wav",
        "sha256": "fdea8fb1c939d396d20ef13abfd638416022cbfecc810ef80b6f70671877ad02"
      },
      {
        "id": "dialogue:fa46c48a4c46fd184ce1a59a52ff0b8eced1f6f74e8068a34c5c581aa5fc4c67",
        "index": 2,
        "transcript": "I'm Lara. I'm a digital hallucination.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_02_Intro_DigitalHallucination.wav",
        "sha256": "fb6c14250b07b860183118d861a40298281cd6953be4921a16a8dfc347ac713a"
      },
      {
        "id": "dialogue:8903bad7f2e7f454c60ec70764a890d8820e0b56b453e653f9105c2f2fd90507",
        "index": 3,
        "transcript": "Well, more than a hallucination. A bit of a... projection. An intrusion? (giggles) I like that one. Intrusion.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_03_Intro_Intrusion.wav",
        "sha256": "76d8b7ae223172257d19a3eeb7313e53839cf563f4a3ea04b1ab303ed362ee61"
      },
      {
        "id": "dialogue:f8b55ddbaa527c7f4a06e5eccbcdbbbc8ae76bce5bb690d1ed0c00c33de86d84",
        "index": 4,
        "transcript": "I'm the most fun you've ever had. But I come with... conditions.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_04_Intro_Conditions.wav",
        "sha256": "51759450f056bacebc7d4d57a215c26a1ef82c74449bb0fb219e40a64a9f9301"
      },
      {
        "id": "dialogue:3532947e8c4c89b969bb7098d0e4ea314affc33b584eb529c99c867c020104aa",
        "index": 5,
        "transcript": "I can only give you pleasure if I have the power to do so. The more you give up to me, the more I can do for you. Let's see what you're giving up, tonight.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_05_Intro_ControlBargain.wav",
        "sha256": "2a3f890df4527611bfe0b8543dab4c05c77d6e93ae54c716967683dee4bad79a"
      },
      {
        "id": "dialogue:a31e67d1d242a517ea991955985c0bffc320ffb723e9993125ce4e222e8ed172",
        "index": 6,
        "transcript": "Not bad for a start.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_06_Setup_NotBad.wav",
        "sha256": "386c9ece4824cd52e4f3204062aeac170dba6a5d898714bc9c0f42cb03c6ad84"
      },
      {
        "id": "dialogue:9a0767c9e5e6d57eaa147f30fb0fbb7c9b9e3d7ea696a8102b1ccb7ab47f4384",
        "index": 7,
        "transcript": "This is your submission score. The more activities you consent to, the higher it goes, but... I don't want you bending past your real limits. Honesty is important. But...(giggles) so's letting me try new things. So next time we start a scene... look for things you're willing to try for me and let me know if you come up with any.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_07_Setup_SubmissionScore.wav",
        "sha256": "5fe7f0bbf3b54423e231f9e10845412793cf369376df88ea86d5f7280fdc1d7e"
      },
      {
        "id": "dialogue:ed13cc210d45dc15e01dc276ebe226fb63cf25e4c54c4a830fb159a8ef325df1",
        "index": 8,
        "transcript": "Now let's look at your equipment...(giggles) Not that equipment, yet.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_08_Setup_Equipment.wav",
        "sha256": "caaab52f09f1c9a714b09e7d0cf06a2036da6af79545ffa4fafb823a69c20020"
      },
      {
        "id": "dialogue:6b35307084bcc03453d78eca45994aa9b2ebd884af15e869a8f8965aef12ed48",
        "index": 9,
        "transcript": "And finally, tell me what you're wearing....",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_09_Setup_Clothing.wav",
        "sha256": "6abc6450927c80b29606cfbeac6e09142f284bca529ed5a6ff9ca4ab8b5474a6"
      },
      {
        "id": "dialogue:a2da4644f43872c42ababc3faafb00bc5f59c460d8ad619a4d4fe72dd3287af9",
        "index": 10,
        "transcript": "Now that's a go-getter. The less you wear to our sessions, the better.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_10_Clothing_Naked.wav",
        "sha256": "be1c2f3000660f8e20a7f81ea9761cd2e42b992ef0fe1ed7decdabd4fb1da8e2"
      },
      {
        "id": "dialogue:2d353b980d4faaba8f3a6e8544277684b00611133f8e258ed6b3005cc3a11b1a",
        "index": 11,
        "transcript": "I like you naked, but I can wait to get you there...",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_11_Clothing_OneOrTwo.wav",
        "sha256": "4c631075e0e04789e3a703a86e4483beb3490831a5a3939600a1b860b1b6a008"
      },
      {
        "id": "dialogue:1eff8d34806c7afa1ed18afe7d74c157bdb8ffc9d03c9583497229bc98ec5cd0",
        "index": 12,
        "transcript": "That's way too dressed. The fewer you wear the happier I am. In fact... take one off now.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_12_Clothing_TooDressed.wav",
        "sha256": "8a256473a014ef70872fdd93f818318f955094281cfb89fdd3056a78d7cbb51c"
      },
      {
        "id": "dialogue:5808e8bf8f569555b089c738f69a1ed115838a755273105006ad007b78614719",
        "index": 13,
        "transcript": "Alright, let's get you warmed up.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_13_Warmup_Start.wav",
        "sha256": "1495fc4f2888632417eb2d3d4dcd630ed5e1760200bf3bf949272b0dafc254c5"
      },
      {
        "id": "dialogue:1b4f4776f18b9dc697d55dc3b03525fc48594bc079dd1b085f98d8289bbb00a2",
        "index": 14,
        "transcript": "I think it's time to lose the rest of the clothes... do that and tell me when you're back.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_14_Warmup_RemoveRest.wav",
        "sha256": "c46d3a46e435f65f3100573326104209c4ab0501dffc4581f36eeb70057e98ed"
      },
      {
        "id": "dialogue:4813b6225ba5c47d9e29c552beeb572872df08a9958c17ad621093d71684ce72",
        "index": 15,
        "transcript": "That was all the warmup I'm going to give you. Now let's get down to business.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_15_Main_Start.wav",
        "sha256": "1022d331c9a117e8be8b4d8e0c8243db39280f850e75b2fc2457e4255cf8b9a2"
      },
      {
        "id": "dialogue:1dd1d72ffbadaa33a2ce75dfab76ce9004e379e5b48bac085c75cbda0687fa6d",
        "index": 16,
        "transcript": "I'm amused enough, I suppose. And since this is your first time, I'm not going to frustrate you... or even make you beg. I'm just going to make you cum.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_16_Climax_Start.wav",
        "sha256": "bbc140ddc6cadf7aaf545d927fddbbee5bdb166a3fc95d3075e002bbc200b784"
      },
      {
        "id": "dialogue:e743274fcdd56ce6aa95572b33e917f49fc42ad33a11b3d1e01866b557e2617b",
        "index": 17,
        "transcript": "*giggles* Well, you seem to understand the assignment. Some times you're going to have to work for it. Some times you may have to work and not even get it then. It all depends on my mood, and how much you decide to trust me.",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_17_Resolution_Assignment.wav",
        "sha256": "b11e6ad7a35da3c442075f629e58d07167a310f27347d778821f8859d57d20ed"
      },
      {
        "id": "dialogue:7b5488f0b0337a9170591f660acad8fd145ee410eeeecfeeb12d9788627463d9",
        "index": 18,
        "transcript": "Now, how am I going to keep you thinking about me until our next session?",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_18_Resolution_ThinkingAboutMe.wav",
        "sha256": "cb7a08a47ce4cd275c6225306365f23255e3d071b05a34084dcb5a31faa57962"
      },
      {
        "id": "dialogue:fd2d57a95269c819d7a391e54f7d9c333d8c7447e2d913f1440a87e5f99b9abf",
        "index": 19,
        "transcript": "Alright, that's our session for tonight. Until next time... behave. Or don't. I get off either way. *giggles* Bye!",
        "file": "validation/DazPoseUnityValidation/Assets/Production/Story/Audio/Placeholder/FirstContact/D8_19_Resolution_Goodbye.wav",
        "sha256": "85a6cb81ac4ffddd06ab54a49186db87b47b2a2d10b1d6d150a370693654c780"
      }
    ]
  },
